{
  "name": "@budden/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && bun scripts/bundle-migrations.ts",
    "db:bundle": "bun scripts/bundle-migrations.ts",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@budden/shared": "workspace:*",
    "@budden/config": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "ulid": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1"
  }
}
